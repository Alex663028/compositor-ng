# 文本文件一律 LF（仓库内现有源码已是 LF），避免 Windows 检出后整文件 diff。
* text=auto eol=lf

# 二进制资产：不做换行转换与文本 diff。
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.ttf binary
*.otf binary
*.bin binary
*.spv binary
*.exr binary
*.hap binary
*.psd binary

# 语言统计：第三方 vendoring 不计入仓库语言占比。
engine/third_party/** linguist-vendored
resources/*.bin linguist-generated
