# AI生成
# compositor-ng 构建产物与临时文件。
#
# 原则：仓库里只放源码与契约文件。任何能由scripts/ 重新生成的东西都不入库，
# 避免构建产物被误当源码 review，或污染 diff。

# --------------------------------------------------------------- 构建输出
# 主构建目录（build.py / build_windows_shell.py / run_regression.py 共用）
build/

# 早期调试留下的验证目录（现已清空，仍保留规则防止复发）
build_verify_r5/
build_*/
# CMake 路径（cmake -B build-cmake）的输出目录；与 build/ 同一性质
build-cmake/

# 交叉编译与绑定生成脚本的常见落点
out/
dist/
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp
# 共享构建产物不是契约文件（内容随源码变），只保留源码与构建脚本。
compositor_engine.dll
libcompositor_engine.so
libcompositor_engine.dylib

# 根目录散落的图像/文档产物（测试与脚本的临时输出）
#
# 注意两个例外：engine/render/spirv/ 下的 .comp 是从 gpu_kernel.cpp 抽取出的
# GLSL **源码**（供人工审阅），同目录的 .comp.spv 与 gpu_kernel_spv.h 是被
# vulkan_backend.cpp #include 的 SPIR-V 字模块 —— 三者都是构建的必需输入，
# 不是产物，必须入库。
out.png
*.comp/
*.comp
!engine/render/spirv/gpu_kernel.comp
!docs/**/*.comp
build_test_*.png

# --------------------------------------------------------------- Python 缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------- 日志与临时文件
*.log
*.tmp
*.bak
*.orig
*.rej
# 拆分重放系列（split-lf-series）曾把 8309 行的 tmp_head.txt 误提交进分支；
# 临时清单/草稿一律不入库。
tmp_*.txt

# --------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------- 外壳运行期输出（可重跑生成，不入库）
# S16 `--present-bench` 的基准报告；`--selftest` 的 compositor_shell_selftest.txt 是基线，入库。
present_bench.txt

# ---------------------------------------------- 鸿蒙 HAP 工程（OPT-22，可重跑生成）
# hvigor 缓存 / 模块依赖 / 构建输出（entry/build 已被上面的 build/ 规则覆盖）。
# libs/*/libcompositor.so 与 libc++_shared.so 是构建产物：scripts/build_ohos_hap.sh
# 从 build_ohos_shell.sh 产出拷入，不入库。*.hap 同理。
shells/ohos/.hvigor/
shells/ohos/**/oh_modules/
*.hap
# zig 编译器缓存：与产物分开，--clean 不该牵连它（见 scripts/build.py child_env）
.zig-cache/

# ---------------------------------------------- 审计报告与探针截图（不入库）
# 内部审计报告、`visual_check.py` 的逐步骤截图与运行日志都落在 report/ 下；
# 它们是过程证据，可由脚本重新生成，不入库（公开仓库只留源码与契约文档）。
report/
